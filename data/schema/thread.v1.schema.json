{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/o-oOvOo-o/praxis-threads/schema/thread.v1.schema.json",
  "title": "Praxis shared thread v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "threadId",
    "title",
    "submittedBy",
    "createdAt",
    "publishedAt",
    "source",
    "praxis",
    "stats",
    "conversation",
    "provenance"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "threadId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "submittedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubLogin", "gitName"],
      "properties": {
        "githubLogin": { "type": "string", "minLength": 1 },
        "gitName": { "type": ["string", "null"] }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] }
      }
    },
    "praxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "modelProvider", "cliVersion", "originator"],
      "properties": {
        "model": { "type": ["string", "null"] },
        "modelProvider": { "type": ["string", "null"] },
        "cliVersion": { "type": ["string", "null"] },
        "originator": { "type": ["string", "null"] }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageCount", "redactionCount"],
      "properties": {
        "messageCount": { "type": "integer", "minimum": 1 },
        "redactionCount": { "type": "integer", "minimum": 0 }
      }
    },
    "conversation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": { "enum": ["user", "assistant"] },
          "phase": { "type": ["string", "null"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rolloutSha256", "redactions"],
      "properties": {
        "rolloutSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "redactions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
